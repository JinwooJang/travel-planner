{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"api/ has no dependencies\"",
  "buildCommand": "mkdir -p public && cp index.html public/index.html",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/s/:id", "destination": "/index.html" }],
  "headers": [{ "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }]
}
